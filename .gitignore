# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Copilot Python env + runtime artifacts
copilot/.venv/
copilot/**/__pycache__/
copilot/*.egg-info/
copilot/data/runs/
copilot/data/lessons.jsonl

# Map history crawl artifacts
copilot/data/crawl_cache/
copilot/data/pdf_cache/
# Improve-run JSON dumps (keep latest optional — full history is local)
copilot/data/improve/
copilot/data/pdf_cache/

# Stale registry snapshots
data/source-registry.backup.json

# GovEase browser captures (working artifacts, not source)
data/govease-capture/

# SRI browser captures (working artifacts, not source)
data/sri-capture/

# Results-crawl output. Regenerable with `npm run crawl:results`, and
# deliberately outside the corpus until each source has a rule in labels.py —
# a 3,724-row candidate batch sitting in git reads as data, and it is not yet.
# The review queue is a local tool by construction: crawl-results writes to
# disk, and a Vercel filesystem is read-only.
data/results-candidates.jsonl
data/results-crawl-report.json

# Unrelated projects that end up in the repo root — not DeedPilot source.
lca-lc-foundations/

# Adapter fixtures captured during a crawl — large, regenerable, not reviewed.
data/samples/

# CAPE Component Seven output — large media, reproducible from the database
artifacts/

# Ad-hoc sampler used while tuning the intel loop
scripts/.intel-sample.mts
